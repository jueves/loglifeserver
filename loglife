#!/bin/bash
# LogLife Client - Minimal bash script

# Load .env file if it exists
if [ -f .env ]; then
  # Parse .env file, ignoring comments and empty lines
  while IFS='=' read -r key value || [ -n "$key" ]; do
    # Skip comments and empty lines
    [[ "$key" =~ ^#.*$ ]] && continue
    [[ -z "$key" ]] && continue

    # Remove leading/trailing whitespace and quotes
    key=$(echo "$key" | xargs)
    value=$(echo "$value" | xargs | sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//")

    # Export the variable
    if [ "$key" = "LOGLIFE_SERVER" ]; then
      LOGLIFE_SERVER="$value"
    elif [ "$key" = "LOGLIFE_API_KEY" ]; then
      LOGLIFE_API_KEY="$value"
    fi
  done < .env
fi

SERVER="${LOGLIFE_SERVER:-http://localhost:3001}"
API_KEY="${LOGLIFE_API_KEY:-change-me-in-production}"

case "$1" in
  log)
    if [ -z "$2" ] || [ -z "$3" ]; then
      echo "Usage: $0 log <event_key> <value>"
      exit 1
    fi
    curl -s -G "${SERVER}/log" \
      --data-urlencode "event_key=$2" \
      --data-urlencode "value=$3" \
      --data-urlencode "key=${API_KEY}" | jq -r 'if .ok then "✓ Logged" else "✗ Failed" end'
    ;;
  query)
    curl -s "${SERVER}/logs?key=${API_KEY}" | jq -r '.[] | "\(.id)\t\(.timestamp)\t\(.event_key)\t\(.value)"'
    ;;
  *)
    echo "Usage: $0 {log|query}"
    echo ""
    echo "Examples:"
    echo "  $0 log temperature 25.5"
    echo "  $0 log mi_variable \"este es el valor de la variable\""
    echo "  $0 query"
    echo ""
    echo "Configuration:"
    echo "  Create a .env file with:"
    echo "    LOGLIFE_SERVER=http://localhost:3001"
    echo "    LOGLIFE_API_KEY=your-api-key"
    echo ""
    echo "  Or use environment variables:"
    echo "    LOGLIFE_SERVER  (default: http://localhost:3001)"
    echo "    LOGLIFE_API_KEY (default: change-me-in-production)"
    exit 1
    ;;
esac
