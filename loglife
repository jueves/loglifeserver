#!/bin/bash
# LogLife Client - Minimal bash script

# Load .env file if it exists
if [ -f .env ]; then
  while IFS='=' read -r key value || [ -n "$key" ]; do
    [[ "$key" =~ ^#.*$ ]] && continue
    [[ -z "$key" ]] && continue
    key=$(echo "$key" | xargs)
    value=$(echo "$value" | xargs | sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//")
    if [ "$key" = "LOGLIFE_SERVER" ]; then
      LOGLIFE_SERVER="$value"
    elif [ "$key" = "LOGLIFE_API_KEY" ]; then
      LOGLIFE_API_KEY="$value"
    fi
  done < .env
fi

SERVER="${LOGLIFE_SERVER:-http://localhost:3001}"
LOGLIFE_API_KEY="${LOGLIFE_API_KEY:-change-me-in-production}"

# Detect if HTTPS and add flag for self-signed certificates
CURL_OPTS="-s"
if [[ "$SERVER" == https://* ]]; then
  CURL_OPTS="$CURL_OPTS -k"
fi

case "$1" in
  log)
    if [ -z "$2" ] || [ -z "$3" ]; then
      echo "Usage: $0 log <event_key> <value>"
      exit 1
    fi
    RESPONSE=$(curl $CURL_OPTS -w "\n%{http_code}" -G "${SERVER}/log" \
      --data-urlencode "event_key=$2" \
      --data-urlencode "value=$3" \
      --data-urlencode "key=${LOGLIFE_API_KEY}" 2>&1)
    if [ $? -ne 0 ]; then
      echo "✗ Failed to connect to $SERVER" >&2
      exit 1
    fi
    HTTP_CODE=$(echo "$RESPONSE" | tail -n1)
    BODY=$(echo "$RESPONSE" | head -n-1)
    if [ "$HTTP_CODE" != "200" ]; then
      echo "✗ Server error (HTTP $HTTP_CODE): $BODY" >&2
      exit 1
    fi
    echo "$BODY" | jq -r 'if .ok then "✓ Logged" else "✗ " + (.error // "Failed") end' 2>/dev/null || echo "$BODY"
    ;;

  query)
    RESPONSE=$(curl $CURL_OPTS -w "\n%{http_code}" "${SERVER}/logs?key=${LOGLIFE_API_KEY}" 2>&1)
    if [ $? -ne 0 ]; then
      echo "✗ Failed to connect to $SERVER" >&2
      exit 1
    fi
    HTTP_CODE=$(echo "$RESPONSE" | tail -n1)
    BODY=$(echo "$RESPONSE" | head -n-1)
    if [ "$HTTP_CODE" != "200" ]; then
      echo "✗ Server error (HTTP $HTTP_CODE): $BODY" >&2
      exit 1
    fi
    echo "$BODY" | jq -r '.data[] | "\(.id)\t\(.timestamp)\t\(.event_key)\t\(.value)"' 2>/dev/null || echo "$BODY"
    ;;

  *)
    echo "Usage: $0 {log|query}"
    echo ""
    echo "Examples:"
    echo "  $0 log temperature 25.5"
    echo "  $0 query"
    echo ""
    echo "Configure via .env file:"
    echo "  LOGLIFE_SERVER=http://localhost:3001"
    echo "  LOGLIFE_API_KEY=your-api-key"
    exit 1
    ;;
esac
